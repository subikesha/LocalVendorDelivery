<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register New Vendor"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Onboard Merchant Store &amp; GPS Location"
                android:textColor="#DBEAFE"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:strokeColor="@color/dividerColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCOUNT CREDENTIALS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VENDOR USERNAME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etVendorUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. fresh_bakery"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etVendorPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter secure password"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="textPassword"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OWNER / MANAGER FULL NAME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etVendorFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Mario Rossi"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="textPersonName"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STORE DETAILS &amp; CATEGORY"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHOP CATEGORY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spnVendorCategory"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHOP NAME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etShopName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Fresh Daily Bakery"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STREET ADDRESS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 14th Main St, Sector 2"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LATITUDE"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/etShopLat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="12.9716"
                                android:background="@drawable/bg_edit_text"
                                android:inputType="numberDecimal|numberSigned"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LONGITUDE"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/etShopLng"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="77.5946"
                                android:background="@drawable/bg_edit_text"
                                android:inputType="numberDecimal|numberSigned"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnQuickCoords"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="📍 Detect Current GPS Coordinates"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/colorPrimary"
                        app:strokeColor="@color/colorPrimary"
                        app:cornerRadius="10dp"
                        android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btnSubmitRegisterVendor"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Register Vendor Shop"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="12dp"
                        app:elevation="0dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
