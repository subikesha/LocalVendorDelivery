<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Container 1: Login / Register Panel -->
    <ScrollView
        android:id="@+id/layoutAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- Card for Login / Register Form -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="@color/dividerColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/tvAuthTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛍️ Customer Portal"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvAuthSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Login or register to order from nearby local vendors"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="16dp" />

                    <!-- Extra Registration Fields -->
                    <LinearLayout
                        android:id="@+id/layoutRegisterFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Name"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginBottom="3dp" />

                        <EditText
                            android:id="@+id/etCustFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. Saranya"
                            android:background="@drawable/bg_edit_text"
                            android:inputType="textPersonName"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone Number"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginBottom="3dp" />

                        <EditText
                            android:id="@+id/etCustPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 9876543210"
                            android:background="@drawable/bg_edit_text"
                            android:inputType="phone"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Address (Required)"
                            android:textSize="12sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginBottom="3dp" />

                        <EditText
                            android:id="@+id/etCustAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 14th Main, Trichy"
                            android:background="@drawable/bg_edit_text"
                            android:inputType="textPostalAddress"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="3dp" />

                    <EditText
                        android:id="@+id/etCustUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter customer username"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="3dp" />

                    <EditText
                        android:id="@+id/etCustPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter password"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="textPassword"
                        android:layout_marginBottom="18dp" />

                    <Button
                        android:id="@+id/btnCustLogin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Login to Account"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnToggleRegisterMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:text="New Customer? Register with Delivery Address"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Container 2: Main Customer Flow -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Custom Header Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeCust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Customer!"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCustDeliveryLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Delivery: Bangalore"
                    android:textColor="#E3F2FD"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewActiveTracking"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                android:text="🛵 Track Order"
                android:textSize="11sp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCustLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="#FFFFFF"
                android:text="Logout"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dynamic Content Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Sub-panel 1: Shop Categories -->
            <LinearLayout
                android:id="@+id/panelCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏪 Choose Shop Category"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a category to view nearby available stores"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="12dp" />

                <ListView
                    android:id="@+id/lvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="10dp" />
            </LinearLayout>

            <!-- Sub-panel 2: Vendor Shops in chosen Category -->
            <LinearLayout
                android:id="@+id/panelShops"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:id="@+id/btnBackToCategories"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back" />

                    <TextView
                        android:id="@+id/tvChosenCategoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shops in Category"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; 10 km"
                        android:background="@drawable/bg_chip_blue"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lvShops"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="10dp" />
            </LinearLayout>

            <!-- Sub-panel 3: Products in Shop -->
            <LinearLayout
                android:id="@+id/panelProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageButton
                        android:id="@+id/btnBackToShops"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tvShopDetailTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shop Name"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Sorted: Lowest to Highest Price"
                            android:textSize="11sp"
                            android:textColor="@color/colorSuccess"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ListView
                    android:id="@+id/lvProducts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="10dp" />
            </LinearLayout>

            <!-- Sub-panel 4: Tracking & Live Route Map (Radar & Route View) -->
            <LinearLayout
                android:id="@+id/panelTracking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageButton
                        android:id="@+id/btnBackToCategoriesFromTracking"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back" />

                    <TextView
                        android:id="@+id/tvTrackingStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛵 Live Order Tracking"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Live Cloud"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSuccess"
                        android:background="@drawable/bg_chip_green" />
                </LinearLayout>

                <!-- High Performance Live Route Radar View -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/dividerColor"
                    app:strokeWidth="1dp">

                    <com.example.localvendordelivery.LiveNavRadarView
                        android:id="@+id/navRadarCust"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvTrackingDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Loading order info..."
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp" />

                        <!-- Rating and Feedback button when order is DELIVERED -->
                        <Button
                            android:id="@+id/btnRateDriver"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="⭐ Rate &amp; Review Delivery Driver"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/colorWarning"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>

        <!-- STICKY FLOATING CART BAR (Always visible at bottom when cart has items) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFloatingCartBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/colorPrimary"
            android:layout_margin="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFloatingCartTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛒 Cart: 0 items | Total: ₹0"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to view cart and checkout"
                        android:textColor="#E3F2FD"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenCartModal"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="View Cart ›"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</FrameLayout>
