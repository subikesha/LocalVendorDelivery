<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Container 1: Delivery Driver Login (No self-registration) -->
    <LinearLayout
        android:id="@+id/layoutAuthDelivery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="@color/dividerColor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛵 Delivery Partner Portal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login with driver credentials created by Administrator"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driver Username"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etDelivUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username (e.g. delivery_boy_1)"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="text"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etDelivPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter password"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="textPassword"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnDelivLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Login to Driver Dashboard"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Driver accounts can only be created by the System Admin"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginTop="14dp"
                    android:layout_gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Container 2: Main Delivery Dashboard -->
    <LinearLayout
        android:id="@+id/layoutMainDelivery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeDeliv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Dashboard"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Live GPS Tracking &amp; Cloud Sync Active"
                    android:textColor="#E3F2FD"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDelivLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="#FFFFFF"
                android:text="Logout"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Sub-panel A: Orders assigned -->
        <LinearLayout
            android:id="@+id/panelDelivOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛵 Assigned Delivery Tasks"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Cloud Synced"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorSuccess"
                    android:background="@drawable/bg_chip_green" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewDriverFeedback"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⭐ View Customer Ratings &amp; Reviews"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/colorWarning"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <ListView
                android:id="@+id/lvDelivOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="10dp" />
        </LinearLayout>

        <!-- Sub-panel B: Live Navigation & Simulation -->
        <LinearLayout
            android:id="@+id/panelDelivNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageButton
                    android:id="@+id/btnBackToDelivList"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Live Delivery Navigation"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/dividerColor"
                app:strokeWidth="1dp">

                <com.example.localvendordelivery.LiveNavRadarView
                    android:id="@+id/navRadarDeliv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- Simulate GPS Movement button -->
                <Button
                    android:id="@+id/btnSimulateMove"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="▶️ Simulate GPS Move"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <!-- Mark Delivered button -->
                <Button
                    android:id="@+id/btnMarkDelivered"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="✅ Mark Delivered"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
