<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Container 1: Delivery Driver Login -->
    <LinearLayout
        android:id="@+id/layoutAuthDelivery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        android:background="@color/colorBackground"
        android:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeColor="@color/dividerColor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="🛵"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Partner"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rider Fleet Operations"
                            android:textSize="11sp"
                            android:textColor="@color/colorSuccess"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login with credentials assigned by Dispatch Administrator"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="20dp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DRIVER USERNAME"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etDelivUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. delivery_boy_1"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etDelivPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your password"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="textPassword"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:layout_marginBottom="22dp" />

                <Button
                    android:id="@+id/btnDelivLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Login to Driver Dashboard"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/colorSuccess"
                    app:cornerRadius="12dp"
                    app:elevation="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Driver partner onboarding is managed by the System Admin"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Container 2: Main Delivery Dashboard -->
    <LinearLayout
        android:id="@+id/layoutMainDelivery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeDeliv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Dashboard"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Live GPS &amp; Cloud Telemetry Active"
                    android:textColor="#DBEAFE"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDelivLogout"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="#FFFFFF"
                android:text="Logout"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Sub-panel A: Orders assigned -->
        <LinearLayout
            android:id="@+id/panelDelivOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Assigned Deliveries"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Cloud Synced"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorSuccess"
                    android:background="@drawable/bg_chip_green" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewDriverFeedback"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⭐ View Customer Ratings &amp; Reviews"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/colorAccent"
                app:strokeColor="@color/colorAccent"
                android:textStyle="bold"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/lvDelivOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="12dp" />
        </LinearLayout>

        <!-- Sub-panel B: Live Navigation & Simulation -->
        <LinearLayout
            android:id="@+id/panelDelivNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageButton
                    android:id="@+id/btnBackToDelivList"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Live Route Navigation"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:strokeColor="@color/dividerColor"
                app:strokeWidth="1dp">

                <com.example.localvendordelivery.LiveNavRadarView
                    android:id="@+id/navRadarDeliv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Simulate GPS Movement button -->
                <Button
                    android:id="@+id/btnSimulateMove"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="▶️ Step GPS Move"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="6dp" />

                <!-- Mark Delivered button -->
                <Button
                    android:id="@+id/btnMarkDelivered"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="✓ Mark Delivered"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/colorSuccess"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
