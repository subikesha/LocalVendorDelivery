<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackAddProduct"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Products"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publish Catalog Items &amp; Inventory"
                android:textColor="#DBEAFE"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- Product Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:strokeColor="@color/dividerColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET STORE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spnVendors"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRODUCT ICON &amp; CATEGORY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spnProductImage"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRODUCT NAME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Farmhouse Veggie Pizza"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRICE (₹ INR)"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/etProductPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="150.0"
                                android:background="@drawable/bg_edit_text"
                                android:inputType="numberDecimal"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STOCK QUANTITY"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/etProductQuantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="50"
                                android:background="@drawable/bg_edit_text"
                                android:inputType="number"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRODUCT DESCRIPTION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etProductDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Fresh farm cheese, crispy crust &amp; herbs"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btnSubmitAddProduct"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Publish Product to Catalog"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/colorAccent"
                        app:cornerRadius="12dp"
                        app:elevation="0dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Existing Products in Selected Shop -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Inventory in Store"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvShopProductsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No shop selected"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/bg_edit_text"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:padding="14dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
