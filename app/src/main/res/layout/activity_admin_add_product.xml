<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackAddProduct"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Products to Vendor"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Product Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="@color/dividerColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Vendor Shop"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spnVendors"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose Product Picture / Icon"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spnProductImage"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Name"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Farmhouse Veggie Pizza"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price (₹ INR)"
                                android:textSize="13sp"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/etProductPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. 150.0"
                                android:background="@drawable/bg_edit_text"
                                android:inputType="numberDecimal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stock Quantity"
                                android:textSize="13sp"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/etProductQuantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. 50"
                                android:background="@drawable/bg_edit_text"
                                android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Description / Details"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etProductDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Fresh farm cheese, crispy crust"
                        android:background="@drawable/bg_edit_text"
                        android:inputType="text"
                        android:layout_marginBottom="18dp" />

                    <Button
                        android:id="@+id/btnSubmitAddProduct"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="➕ Add Product with Picture &amp; Stock"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Existing Products in Selected Shop -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products in Selected Shop"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvShopProductsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No shop selected"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/bg_edit_text"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
